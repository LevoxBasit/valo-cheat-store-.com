---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CHEATS_PRIMARY_SLUG } from '../../config/catalog';
import { getProductPage } from '../../data/products';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, webPageSchema } from '../../utils/schema';
import ProductDetail from '../../components/ProductDetail.astro';
import { useLocale } from '../../i18n';
import { PRODUCT_BASE, PRODUCTS_HUB_PATH } from '../../config/site';
import { responsiveSrcSet, webpSrc } from '../../utils/responsiveImage';

const { locale, t, lp } = useLocale(Astro.currentLocale);
const product = getProductPage(CHEATS_PRIMARY_SLUG, locale);

if (!product) {
  return Astro.redirect(lp('/'));
}

const pagePath = PRODUCT_BASE;
const productsLabel = t.nav.find((link) => link.id === 'products')?.label ?? t.common.breadcrumbProducts;
const breadcrumbs = [
  { name: t.common.breadcrumbHome, path: '/' },
  { name: productsLabel, path: PRODUCTS_HUB_PATH },
  { name: t.cheats.title, path: pagePath },
];
const seo = resolvePageSeo(pagePath, locale);
const lcpSlide = product.images.find((slide) => slide.src);
const lcpPhone = lcpSlide ? webpSrc(lcpSlide.src, 400) : '';
const lcpTablet = lcpSlide ? webpSrc(lcpSlide.src, 640) : '';
const lcpDesktopSrcSet = lcpSlide ? responsiveSrcSet(lcpSlide.src, [640, 800, 960]) : '';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={lcpSlide?.src}
  ogImageAlt={lcpSlide?.alt}
  ogImageWidth={lcpSlide?.width}
  ogImageHeight={lcpSlide?.height}
  jsonLd={[
    webPageSchema({
      name: product.title,
      description: product.subtitle || product.desc,
      url: lp(pagePath),
      locale,
    }),
    breadcrumbSchema(breadcrumbs, locale),
  ]}
>
  {lcpPhone && (
    <link slot="head" rel="preload" as="image" href={lcpPhone} type="image/webp" media="(max-width: 639px)" fetchpriority="high" />
  )}
  {lcpTablet && (
    <link slot="head" rel="preload" as="image" href={lcpTablet} type="image/webp" media="(640px <= width < 1024px)" fetchpriority="high" />
  )}
  {lcpDesktopSrcSet && (
    <link slot="head" rel="preload" as="image" href={lcpTablet} imagesrcset={lcpDesktopSrcSet} imagesizes="760px" type="image/webp" media="(min-width: 1024px)" fetchpriority="high" />
  )}
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />
</BaseLayout>
